DATABASE_URL="file:./dev.db"
SEGREDO_SESSAO="troque-por-um-texto-longo-e-aleatorio"

# Fontes de vagas (todas opcionais; as que ficarem vazias são puladas).
# Adzuna: cadastro gratuito em https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: chave gratuita pedida em https://jooble.org/api/about
JOOBLE_API_KEY=
# Opcional: troca o endereço da API do Jooble (padrão: jooble.org)
JOOBLE_HOST=
# GitHub: opcional, só aumenta o limite de consultas por hora (https://github.com/settings/tokens, sem nenhuma permissão marcada)
GITHUB_TOKEN=

# Alertas por e-mail (opcional). Sem SMTP_HOST, o site funciona e os alertas ficam guardados, mas nada é enviado.
# Funciona com Gmail (use uma "senha de app"), Brevo, Resend, Mailgun... qualquer serviço que ofereça SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente que aparece no e-mail, ex.: TechVagas <avisos@seudominio.com>
EMAIL_DE=
# Endereço público do site, usado nos links dos e-mails (no seu computador: http://localhost:3000)
SITE_URL=http://localhost:3000
