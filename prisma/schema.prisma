generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Níveis (texto, pois o SQLite não tem enumeração): "iniciante" | "intermediario" | "avancado"

model Habilidade {
  id         Int     @id @default(autoincrement())
  slug       String  @unique
  nome       String
  area       String
  sinonimos  String  @default("") // separados por vírgula

  usuarios   HabilidadeDoUsuario[]
  vagas      RequisitoDaVaga[]
  cursos     HabilidadeDoCurso[]
}

model Usuario {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  nome          String
  senhaHash     String
  curso         String   @default("")
  cidade        String   @default("")
  criadoEm      DateTime @default(now())

  habilidades   HabilidadeDoUsuario[]
  vagasSalvas   VagaSalva[]
  alertas       Alerta[]
}

model HabilidadeDoUsuario {
  usuarioId     Int
  habilidadeId  Int
  nivel         String @default("iniciante")

  usuario       Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  habilidade    Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, habilidadeId])
}

model Vaga {
  id          Int    @id @default(autoincrement())
  titulo      String
  empresa     String
  cidade      String // texto como veio da fonte
  // Localização já interpretada, para filtrar: cidade, sigla do estado e a cidade sem acentos/maiúsculas.
  cidadeNome   String @default("")
  uf           String @default("")
  cidadeChave  String @default("")
  modalidade  String // "presencial" | "hibrido" | "remoto"
  tipo        String // "estagio" | "trainee" | "junior"
  area        String
  descricao   String
  link        String @default("")

  // De onde veio: "exemplo" (vagas fictícias da demonstração) ou o nome de uma fonte real.
  origem        String   @default("exemplo")
  idExterno     String?  // identificador da vaga na fonte; vazio nas vagas de exemplo
  publicadaEm   DateTime?
  // Salário ou bolsa em reais por mês, quando o anúncio informa. Origem: "fonte" (campo próprio da fonte),
  // "texto" (identificado no texto do anúncio) ou "" (sem valor).
  salarioMin    Int?
  salarioMax    Int?
  salarioOrigem String @default("")

  // false quando a vaga sumiu da fonte mas alguém a tinha salvo: ela fica guardada, mas sai das listagens.
  ativa         Boolean  @default(true)
  // Quando o site achou a vaga pela primeira vez (é o que os alertas por e-mail usam para saber o que é "novo").
  primeiraVezEm DateTime @default(now())
  salvaPor      VagaSalva[]
  atualizadaEm  DateTime @default(now())

  requisitos  RequisitoDaVaga[]

  @@unique([origem, idExterno])
}

model RequisitoDaVaga {
  vagaId        Int
  habilidadeId  Int
  nivelMinimo   String  @default("iniciante")
  obrigatorio   Boolean @default(true)

  vaga          Vaga       @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  habilidade    Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  @@id([vagaId, habilidadeId])
}

model Curso {
  id            Int     @id @default(autoincrement())
  titulo        String
  instituicao   String
  link          String
  gratuito      Boolean
  preco         String  @default("") // texto livre, ex.: "a partir de R$ 49/mês"
  cargaHoraria  Int     @default(0)
  nivel         String  @default("iniciante")
  certificado   Boolean @default(false)
  descricao     String  @default("")

  habilidades   HabilidadeDoCurso[]
}

model HabilidadeDoCurso {
  cursoId       Int
  habilidadeId  Int
  nivelEnsinado String  @default("iniciante")
  principal     Boolean @default(false) // a habilidade central do curso

  curso         Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  habilidade    Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  @@id([cursoId, habilidadeId])
}

model VagaSalva {
  usuarioId Int
  vagaId    Int
  criadaEm  DateTime @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  vaga      Vaga    @relation(fields: [vagaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, vagaId])
}

/// Aviso por e-mail de vagas NOVAS que combinam com estes filtros.
model Alerta {
  id             Int       @id @default(autoincrement())
  usuarioId      Int
  nome           String
  uf             String    @default("")
  cidade         String    @default("")
  cidadeChave    String    @default("")
  incluirRemotas Boolean   @default(true)
  tipo           String    @default("")
  area           String    @default("")
  salarioMinimo  Int?
  ativo          Boolean   @default(true)
  // Código secreto do link "cancelar este alerta" do e-mail (funciona sem login).
  token          String    @unique
  criadoEm       DateTime  @default(now())
  // Só entram no e-mail as vagas achadas depois deste momento (ou depois da criação, no primeiro envio).
  ultimoEnvioEm  DateTime?

  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}
