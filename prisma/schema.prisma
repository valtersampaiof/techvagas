generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Níveis (texto, pois o SQLite não tem enumeração): "iniciante" | "intermediario" | "avancado"

model Habilidade {
  id         Int     @id @default(autoincrement())
  slug       String  @unique
  nome       String
  area       String
  sinonimos  String  @default("") // separados por vírgula

  usuarios   HabilidadeDoUsuario[]
  vagas      RequisitoDaVaga[]
  cursos     HabilidadeDoCurso[]
}

model Usuario {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  nome          String
  senhaHash     String
  curso         String   @default("")
  cidade        String   @default("")
  criadoEm      DateTime @default(now())

  habilidades   HabilidadeDoUsuario[]
}

model HabilidadeDoUsuario {
  usuarioId     Int
  habilidadeId  Int
  nivel         String @default("iniciante")

  usuario       Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  habilidade    Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, habilidadeId])
}

model Vaga {
  id          Int    @id @default(autoincrement())
  titulo      String
  empresa     String
  cidade      String
  modalidade  String // "presencial" | "hibrido" | "remoto"
  tipo        String // "estagio" | "trainee" | "junior"
  area        String
  descricao   String
  link        String @default("")

  // De onde veio: "exemplo" (vagas fictícias da demonstração) ou o nome de uma fonte real.
  origem        String   @default("exemplo")
  idExterno     String?  // identificador da vaga na fonte; vazio nas vagas de exemplo
  publicadaEm   DateTime?
  atualizadaEm  DateTime @default(now())

  requisitos  RequisitoDaVaga[]

  @@unique([origem, idExterno])
}

model RequisitoDaVaga {
  vagaId        Int
  habilidadeId  Int
  nivelMinimo   String  @default("iniciante")
  obrigatorio   Boolean @default(true)

  vaga          Vaga       @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  habilidade    Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  @@id([vagaId, habilidadeId])
}

model Curso {
  id            Int     @id @default(autoincrement())
  titulo        String
  instituicao   String
  link          String
  gratuito      Boolean
  preco         String  @default("") // texto livre, ex.: "a partir de R$ 49/mês"
  cargaHoraria  Int     @default(0)
  nivel         String  @default("iniciante")
  certificado   Boolean @default(false)
  descricao     String  @default("")

  habilidades   HabilidadeDoCurso[]
}

model HabilidadeDoCurso {
  cursoId       Int
  habilidadeId  Int
  nivelEnsinado String  @default("iniciante")
  principal     Boolean @default(false) // a habilidade central do curso

  curso         Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  habilidade    Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  @@id([cursoId, habilidadeId])
}
